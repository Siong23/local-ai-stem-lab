# ==============================================================================
# AI Workshop FastAPI Device Gateway Configuration Template
# INSTRUCTIONS: Copy this file to '.env' in the same folder and update values.
# ==============================================================================

# Central host IP address of your local classroom workshop network server
# ⚠️ REPLACE 192.168.50.10 WITH YOUR ACTUAL CENTRAL SERVER IP ADDRESS
MQTT_HOST=192.168.50.10
MQTT_PORT=1883

# Comma-separated list of allowlisted group identifiers permitted by the gateway
ALLOWED_GROUPS=GROUP01,GROUP02,GROUP03,GROUP04,GROUP05,GROUP06,GROUP07,GROUP08,GROUP09,GROUP10

# Maximum timeframe (in seconds) the gateway will wait for a student hardware response
COMMAND_TIMEOUT_SECONDS=8
